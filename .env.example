RINGHUB_SECRET=            # ringhub secret
RINGHUB_ADMIN_TOKEN=       # ringhub secret  (dashboard login)
RINGHUB_CONTEXT_TOKEN=     # ringhub secret  (phone context feed)
RINGHUB_PUBLIC_URL=        # https://hub.your-tailnet.ts.net
NTFY_PUBLIC_URL=           # how your iPhone reaches ntfy, e.g. https://pi.your-tailnet.ts.net:8443
NTFY_TOPIC=ring            # private server with deny-all access, so a simple name is fine
NTFY_TOKEN=                # tk_... from: docker compose exec ntfy ntfy token add me
TZ=America/New_York
