# Don't edit this by hand for the Pi / Docker stack: generate a complete .env with fresh secrets:
#   PYTHONPATH=src python3 -m ringhub.envfile --host <machine>.<tailnet>.ts.net --tag <tag> --tz <Area/City> > .env
# (docs/PI.md). This file documents every variable, for running ringhub any other way.

# Which published image docker compose runs: "main" (default branch), "<branch-name>" with / as -,
# or "sha-<7 chars>" for one exact, tested build.
RINGHUB_TAG=main
RINGHUB_SECRET=            # signs ring webhooks: paste the same value into the Index app
RINGHUB_ADMIN_TOKEN=       # dashboard login
RINGHUB_CONTEXT_TOKEN=     # iPhone Shortcuts / OwnTracks context feed
RINGHUB_PUBLIC_URL=        # how your phone reaches ringhub, e.g. https://pi.your-tailnet.ts.net:8445
NTFY_PUBLIC_URL=           # how your iPhone reaches ntfy, e.g. https://pi.your-tailnet.ts.net:8446 (exactly as typed in the ntfy app)
NTFY_TOPIC=                # random, e.g. ring-k3m9x2q7w4ab (must start with "ring-" to match the access rules)
NTFY_TOKEN=                # tk_... from: docker compose exec ntfy ntfy token add --label=ringhub ringhub
NTFY_MIN_PRIORITY=4        # every push at least this priority (4 alerts through Focus on iPhone)
TZ=America/New_York
# ANTHROPIC_API_KEY=
TESLA_CLIENT_ID=           # car control: your app at developer.tesla.com (docs/INTEGRATIONS.md)
TESLA_CLIENT_SECRET=
TESLA_DOMAIN=              # the site that hosts your public key, e.g. you.github.io
GOOGLE_CLIENT_ID=          # Google Calendar: OAuth client, type "Web application"
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_ID=primary
